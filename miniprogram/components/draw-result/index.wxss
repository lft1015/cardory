page {
  --reveal-bg: var(--color-bg);
  --reveal-panel: var(--color-card);
  --reveal-ink: var(--color-text);
  --rarity-n: var(--color-n);
  --rarity-r: var(--color-r);
  --rarity-sr: var(--color-sr);
  --rarity-ssr: var(--color-ssr);
}
.draw-result { position: fixed; inset: 0; z-index: 999; display: flex; flex-direction: column; align-items: center; box-sizing: border-box; padding: 60rpx 30rpx 34rpx; overflow: hidden; color: var(--reveal-ink); background: linear-gradient(180deg, var(--reveal-bg) 0%, #eef6f0 100%); }
.draw-result.rarity-N { background: radial-gradient(circle at 50% 42%, rgba(106, 155, 91, 0.34), transparent 42%), radial-gradient(circle at 18% 80%, rgba(109, 184, 125, 0.2), transparent 34%), linear-gradient(180deg, #f8fcf8, #e7f3e9); }
.draw-result.rarity-R { background: radial-gradient(circle at 50% 42%, rgba(91, 140, 201, 0.36), transparent 42%), radial-gradient(circle at 82% 76%, rgba(109, 184, 125, 0.22), transparent 36%), linear-gradient(180deg, #f7fbfb, #e6eff5); }
.draw-result.rarity-SR { background: radial-gradient(circle at 50% 42%, rgba(139, 92, 184, 0.38), transparent 42%), radial-gradient(circle at 16% 78%, rgba(91, 140, 201, 0.24), transparent 36%), linear-gradient(180deg, #fbf9fc, #eee8f3); }
.draw-result.rarity-SSR { background: radial-gradient(circle at 50% 42%, rgba(201, 160, 43, 0.42), transparent 42%), radial-gradient(circle at 84% 76%, rgba(109, 184, 125, 0.24), transparent 36%), linear-gradient(180deg, #fffdf6, #f4edda); }
.draw-result.rarity-limited { background: radial-gradient(circle at 50% 42%, rgba(109, 184, 125, 0.4), transparent 38%), radial-gradient(circle at 18% 76%, rgba(139, 92, 184, 0.34), transparent 34%), radial-gradient(circle at 84% 24%, rgba(201, 160, 43, 0.34), transparent 32%), linear-gradient(180deg, #fbfcf7, #eaeff0); }
.ambient, .effect-layer { position: absolute; inset: 0; pointer-events: none; }
.ambient { z-index: 0; overflow: hidden; }
.ambient-bloom { position: absolute; left: 50%; top: 52%; width: 620rpx; height: 620rpx; transform: translate(-50%, -50%); border-radius: 50%; background: radial-gradient(circle, rgba(168, 213, 176, 0.34), transparent 68%); animation: ambientBreath 5s ease-in-out infinite; }
.ambient-orbit { position: absolute; left: 50%; top: 53%; border: 1rpx solid rgba(109, 184, 125, 0.2); border-radius: 50%; transform: translate(-50%, -50%) rotate(-18deg); }
.orbit-a { width: 640rpx; height: 340rpx; animation: orbitSpin 18s linear infinite; }
.orbit-b { width: 460rpx; height: 260rpx; animation: orbitSpinReverse 13s linear infinite; }
.ambient-speck { position: absolute; width: 8rpx; height: 8rpx; border-radius: 50%; background: rgba(109, 184, 125, 0.58); box-shadow: 0 0 18rpx rgba(109, 184, 125, 0.34); animation: speckFloat 4s ease-in-out infinite; }
.speck-a { left: 14%; top: 28%; animation-delay: -1.2s; }
.speck-b { right: 15%; top: 47%; animation-delay: -2.5s; }
.speck-c { left: 28%; bottom: 21%; animation-delay: -0.4s; }
.single-stage { position: relative; z-index: 2; display: flex; align-items: center; justify-content: center; width: 100%; flex: 1; min-height: 0; }
.single-card { position: relative; z-index: 1; width: 63vw; height: 91vw; max-width: 440rpx; max-height: 638rpx; min-height: 420rpx; perspective: 1400rpx; transform: translateZ(0); }
.card-face { position: absolute; inset: 0; overflow: hidden; border-radius: 28rpx; backface-visibility: hidden; -webkit-backface-visibility: hidden; }
.card-back { display: flex; flex-direction: column; align-items: center; justify-content: center; color: rgba(255, 255, 255, 0.88); background: linear-gradient(145deg, var(--color-primary), var(--color-primary-dark)); border: 2rpx solid rgba(255, 255, 255, 0.72); box-shadow: 0 20rpx 70rpx rgba(74, 138, 92, 0.18), inset 0 0 0 10rpx rgba(255, 255, 255, 0.1); }
.single-card.rarity-N .card-back { background: linear-gradient(145deg, var(--color-primary), var(--rarity-n)); }
.single-card.rarity-R .card-back { background: linear-gradient(145deg, var(--color-primary-dark), var(--rarity-r)); }
.single-card.rarity-SR .card-back { background: linear-gradient(145deg, var(--color-primary-dark), var(--rarity-sr)); }
.single-card.rarity-SSR .card-back { background: linear-gradient(145deg, var(--color-primary-dark), var(--rarity-ssr)); }
.single-card.rarity-limited .card-back { background: linear-gradient(145deg, var(--color-primary), var(--rarity-sr), var(--rarity-ssr)); }
.card-front { transform: rotateY(180deg); background: var(--reveal-panel); box-shadow: 0 24rpx 82rpx rgba(74, 138, 92, 0.16); }
.single-card.is-flipping .card-back { animation: cardFlipBack 1s cubic-bezier(0.24, 0.78, 0.3, 1) both; }
.single-card.is-flipping .card-front { animation: cardFlipFront 1s cubic-bezier(0.24, 0.78, 0.3, 1) both; }
.single-card.rarity-N.is-flipping .card-back, .single-card.rarity-N.is-flipping .card-front { animation-duration: 1.76s; }
.single-card.rarity-R.is-flipping .card-back, .single-card.rarity-R.is-flipping .card-front { animation-duration: 1.92s; }
.single-card.rarity-SR.is-flipping .card-back, .single-card.rarity-SR.is-flipping .card-front { animation-duration: 2.16s; }
.single-card.rarity-SSR.is-flipping .card-back, .single-card.rarity-SSR.is-flipping .card-front { animation-duration: 2.48s; }
.single-card.rarity-limited.is-flipping .card-back, .single-card.rarity-limited.is-flipping .card-front { animation-duration: 2.88s; }
.single-card.is-revealed .card-back { transform: rotateY(180deg); }
.single-card.is-revealed .card-front { transform: rotateY(0deg); }
.back-grid { position: absolute; inset: 12rpx; border-radius: 20rpx; opacity: 0.45; background-image: linear-gradient(45deg, transparent 47%, rgba(255, 255, 255, 0.24) 48%, transparent 50%), linear-gradient(-45deg, transparent 47%, rgba(255, 255, 255, 0.16) 48%, transparent 50%); background-size: 48rpx 48rpx; }
.back-mark { position: relative; color: #e8f5e9; font-size: 74rpx; text-shadow: 0 0 30rpx rgba(255, 255, 255, 0.42); animation: markPulse 2.4s ease-in-out infinite; }
.back-label { position: relative; margin-top: 24rpx; font-size: 18rpx; letter-spacing: 8rpx; opacity: 0.7; }
.card-frame { position: absolute; inset: 12rpx; border: 2rpx solid currentColor; border-radius: 20rpx; z-index: 2; opacity: 0.5; pointer-events: none; }
.card-image { width: 100%; height: 100%; display: block; opacity: 0.96; }
.card-placeholder { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; padding: 28rpx; box-sizing: border-box; color: var(--color-text); font-size: 34rpx; font-weight: 800; text-align: center; background: linear-gradient(145deg, #ffffff, #eef6f0); }
.card-meta { position: absolute; left: 20rpx; right: 20rpx; top: 20rpx; display: flex; align-items: flex-start; justify-content: space-between; z-index: 3; }
.card-rarity { padding: 10rpx 18rpx; color: #fff; border-radius: 999rpx; font-size: 24rpx; font-weight: 900; line-height: 1.1; letter-spacing: 2rpx; white-space: nowrap; background: rgba(46, 59, 48, 0.68); }
.card-rarity.rarity-N { background: var(--color-n); }
.card-rarity.rarity-R { background: var(--color-r); }
.card-rarity.rarity-SR { background: var(--color-sr); }
.card-rarity.rarity-SSR { background: var(--color-ssr); }
.card-rarity.rarity-limited { background: linear-gradient(135deg, var(--color-primary-dark), var(--color-ssr)); }
.card-badge { padding: 9rpx 16rpx; border-radius: 999rpx; font-size: 21rpx; font-weight: 800; line-height: 1.1; white-space: nowrap; }
.card-badge.new { color: #4a3b0b; background: #f5d978; }
.card-badge.owned { color: #fff; background: rgba(46, 59, 48, 0.62); }
.card-name { position: absolute; left: 24rpx; right: 24rpx; bottom: 24rpx; z-index: 3; color: #fff; font-size: 31rpx; font-weight: 800; text-shadow: 0 2rpx 12rpx rgba(46, 59, 48, 0.72); }
.card-glint { position: absolute; inset: -20%; z-index: 4; pointer-events: none; opacity: 0; background: linear-gradient(112deg, transparent 38%, rgba(255, 255, 255, 0.68) 49%, transparent 60%); transform: translateX(-80%) rotate(8deg); }
.is-revealed .card-glint { animation: cardGlint 1.1s ease-out 0.15s both; }
.effect-layer { z-index: 0; overflow: hidden; }
.effect-ring { position: absolute; left: 50%; top: 50%; border: 1rpx solid currentColor; border-radius: 50%; opacity: 0; transform: translate(-50%, -50%); }
.ring-a { width: 590rpx; height: 300rpx; }
.ring-b { width: 430rpx; height: 230rpx; }
.effect-sweep, .effect-burst, .effect-flash { position: absolute; inset: 0; opacity: 0; }
.effect-sweep { left: -45%; width: 190%; background: linear-gradient(105deg, transparent 42%, rgba(255, 255, 255, 0.66) 50%, transparent 58%); transform: translateX(-80%); }
.effect-burst { left: 50%; top: 50%; right: auto; bottom: auto; width: 40rpx; height: 40rpx; border-radius: 50%; transform: translate(-50%, -50%) scale(0.3); }
.effect-flash { background: rgba(255, 255, 255, 0.4); }
.effect-n { color: var(--rarity-n); }
.effect-n .effect-ring { animation: ringFade 1.8s ease-out both; }
.effect-n .effect-burst { background: radial-gradient(circle, rgba(168, 213, 176, 0.42), transparent 72%); animation: burstSoft 1.8s ease-out both; }
.effect-r { color: var(--rarity-r); }
.effect-r .effect-sweep { animation: sweepAcross 1.9s ease-out both; }
.effect-r .effect-ring { animation: ringExpand 2s ease-out 0.08s both; }
.effect-sr { color: var(--rarity-sr); }
.effect-sr .effect-ring { animation: ringOrbit 2.2s ease-out both; }
.effect-sr .ring-b { animation-delay: 0.16s; }
.effect-sr .effect-burst { background: radial-gradient(circle, rgba(139, 92, 184, 0.34), transparent 72%); animation: burstBloom 2.1s ease-out both; }
.effect-ssr { color: var(--rarity-ssr); }
.effect-ssr .effect-ring { border-width: 2rpx; animation: ringExpand 2.4s cubic-bezier(0.18, 0.7, 0.32, 1) both; }
.effect-ssr .effect-burst { background: radial-gradient(circle, rgba(201, 160, 43, 0.62), transparent 72%); animation: burstBloom 2.25s ease-out both; }
.effect-ssr .effect-sweep { animation: sweepAcross 2.2s ease-out 0.18s both; }
.effect-n .single-card { animation: revealN 1.76s ease-out both; }
.effect-r .single-card { animation: revealR 1.92s cubic-bezier(0.2, 0.8, 0.3, 1) both; }
.effect-sr .single-card { animation: revealSR 2.16s cubic-bezier(0.2, 0.8, 0.3, 1) both; }
.effect-ssr .single-card { animation: premiumJolt 2.48s ease-out both; }
.effect-limited { color: var(--color-primary-dark); }
.effect-limited .effect-ring { border-width: 2rpx; border-image: linear-gradient(90deg, var(--color-primary), var(--color-ssr)) 1; animation: holoOrbit 2.7s ease-out both; }
.effect-limited .effect-sweep { animation: holoSweep 2.5s ease-out both; }
.effect-limited .effect-flash { animation: whiteFlash 1.8s ease-out 0.46s both; }
.effect-limited .effect-burst { background: radial-gradient(circle, rgba(201, 160, 43, 0.62), rgba(109, 184, 125, 0.22) 42%, transparent 72%); animation: burstBloom 2.7s ease-out both; }
.effect-limited .single-card { animation: limitedLift 2.88s cubic-bezier(0.18, 0.8, 0.24, 1) both; }
@keyframes ambientBreath { 0%, 100% { opacity: 0.58; transform: translate(-50%, -50%) scale(0.92); } 50% { opacity: 1; transform: translate(-50%, -50%) scale(1.08); } }
@keyframes orbitSpin { to { transform: translate(-50%, -50%) rotate(342deg); } }
@keyframes orbitSpinReverse { to { transform: translate(-50%, -50%) rotate(-378deg); } }
@keyframes speckFloat { 0%, 100% { opacity: 0.25; transform: translateY(16rpx) scale(0.8); } 50% { opacity: 0.9; transform: translateY(-18rpx) scale(1.2); } }
@keyframes markPulse { 0%, 100% { opacity: 0.52; transform: scale(0.92); } 50% { opacity: 1; transform: scale(1.08); } }
@keyframes cardFlipBack { 0% { transform: rotateY(0); } 100% { transform: rotateY(-180deg); } }
@keyframes cardFlipFront { 0% { transform: rotateY(180deg); } 100% { transform: rotateY(0); } }
@keyframes cardGlint { 0% { opacity: 0; transform: translateX(-80%) rotate(8deg); } 22% { opacity: 0.72; } 100% { opacity: 0; transform: translateX(80%) rotate(8deg); } }
@keyframes revealN { 0% { opacity: 0.72; transform: scale(0.96); } 100% { opacity: 1; transform: translateZ(0); } }
@keyframes revealR { 0% { opacity: 0.5; transform: translateY(18rpx) scale(0.94); } 62% { opacity: 1; transform: translateY(-6rpx) scale(1.02); } 100% { transform: translateZ(0); } }
@keyframes revealSR { 0% { opacity: 0.45; transform: rotate(-4deg) scale(0.94); } 42% { opacity: 1; transform: rotate(2deg) scale(1.02); } 72% { transform: rotate(-1deg); } 100% { transform: translateZ(0); } }
@keyframes ringFade { 0% { opacity: 0; transform: translate(-50%, -50%) scale(0.82); } 35% { opacity: 0.55; } 100% { opacity: 0; transform: translate(-50%, -50%) scale(1.14); } }
@keyframes ringExpand { 0% { opacity: 0; transform: translate(-50%, -50%) scale(0.5) rotate(-8deg); } 24% { opacity: 0.8; } 100% { opacity: 0; transform: translate(-50%, -50%) scale(1.35) rotate(16deg); } }
@keyframes ringOrbit { 0% { opacity: 0; transform: translate(-50%, -50%) scale(0.55) rotate(-35deg); } 30% { opacity: 0.82; } 100% { opacity: 0; transform: translate(-50%, -50%) scale(1.2) rotate(160deg); } }
@keyframes holoOrbit { 0% { opacity: 0; transform: translate(-50%, -50%) scale(0.38) rotate(-45deg); } 24% { opacity: 1; } 100% { opacity: 0; transform: translate(-50%, -50%) scale(1.52) rotate(220deg); } }
@keyframes burstSoft { 0% { opacity: 0; transform: translate(-50%, -50%) scale(0.3); } 35% { opacity: 0.45; } 100% { opacity: 0; transform: translate(-50%, -50%) scale(4); } }
@keyframes burstBloom { 0% { opacity: 0; transform: translate(-50%, -50%) scale(0.25); } 18% { opacity: 1; } 100% { opacity: 0; transform: translate(-50%, -50%) scale(6); } }
@keyframes sweepAcross { 0% { opacity: 0; transform: translateX(-85%); } 24% { opacity: 0.92; } 100% { opacity: 0; transform: translateX(85%); } }
@keyframes holoSweep { 0% { opacity: 0; transform: translateX(-85%) skewX(-8deg); } 20% { opacity: 1; } 100% { opacity: 0; transform: translateX(85%) skewX(-8deg); } }
@keyframes whiteFlash { 0% { opacity: 0; } 18% { opacity: 0.54; } 100% { opacity: 0; } }
@keyframes premiumJolt { 0%, 100% { transform: translate(0, 0) rotate(0); } 22% { transform: translate(-3rpx, 1rpx) rotate(-0.3deg); } 38% { transform: translate(3rpx, -1rpx) rotate(0.25deg); } 52% { transform: translate(-2rpx, 1rpx) rotate(-0.15deg); } 70% { transform: translate(1rpx, 0) rotate(0.1deg); } }
@keyframes limitedLift { 0% { transform: translateY(14rpx) scale(0.96); opacity: 0.3; } 36% { opacity: 1; } 100% { transform: translateY(0) scale(1); opacity: 1; } }
@media (max-width: 360px) { .draw-result { padding-left: 18rpx; padding-right: 18rpx; } }
@media (prefers-reduced-motion: reduce) { .ambient-orbit, .ambient-bloom, .ambient-speck, .back-mark, .single-card { animation: none; } .single-card.is-flipping .card-back, .single-card.is-flipping .card-front { animation-duration: 0.01ms; } }
