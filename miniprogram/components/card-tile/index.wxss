.card-tile {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  box-sizing: border-box;
}

.size-normal,
.size-normal .card-frame { width: 320rpx; }
.size-normal .card-frame { height: 448rpx; }
.size-small .card-frame { width: 120rpx; height: 165rpx; }
.size-large .card-frame { width: 220rpx; height: 300rpx; }

.card-frame {
  position: relative;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
  border: 2rpx solid rgba(255, 255, 255, 0.78);
  border-radius: 28rpx;
  background: rgba(106, 155, 91, 0.22);
  box-shadow: 0 14rpx 34rpx rgba(46, 59, 48, 0.11), inset 0 0 0 4rpx rgba(255, 255, 255, 0.18);
  transition: transform 0.2s, box-shadow 0.2s;
}

.card-frame:active {
  transform: translateY(2rpx) scale(0.98);
  box-shadow: 0 7rpx 18rpx rgba(46, 59, 48, 0.12), inset 0 0 0 4rpx rgba(255, 255, 255, 0.18);
}

.card-frame.rarity-N { background: linear-gradient(145deg, rgba(106, 155, 91, 0.32), rgba(255, 255, 255, 0.66)); }
.card-frame.rarity-R { background: linear-gradient(145deg, rgba(91, 140, 201, 0.32), rgba(255, 255, 255, 0.68)); }
.card-frame.rarity-SR { background: linear-gradient(145deg, rgba(139, 92, 184, 0.32), rgba(255, 255, 255, 0.68)); }
.card-frame.rarity-SSR { background: linear-gradient(145deg, rgba(201, 160, 43, 0.42), rgba(109, 184, 125, 0.18)); }

.card-frame::after {
  content: '';
  position: absolute;
  inset: 7rpx;
  z-index: 2;
  border: 2rpx solid currentColor;
  border-radius: 21rpx;
  opacity: 0.32;
  pointer-events: none;
}

.card-frame.rarity-N::after { color: var(--color-n); }
.card-frame.rarity-R::after { color: var(--color-r); }
.card-frame.rarity-SR::after { color: var(--color-sr); }
.card-frame.rarity-SSR::after { color: var(--color-ssr); opacity: 0.5; }

.card-img-area {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
}

.framed.size-normal .card-img-area { padding: 18rpx; }

.card-img,
.card-placeholder,
.card-ghost { width: 100%; height: 100%; border-radius: 20rpx; }

.card-img { display: block; }

.card-placeholder,
.card-ghost {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.card-placeholder {
  padding: 18rpx;
  color: var(--color-text);
  font-size: 23rpx;
  font-weight: 800;
  text-align: center;
  background: rgba(255, 255, 255, 0.58);
}

.card-ghost {
  background: radial-gradient(circle at 50% 42%, rgba(168, 213, 176, 0.2), transparent 42%), repeating-linear-gradient(45deg, rgba(255, 255, 255, 0.2) 0 14rpx, transparent 14rpx 28rpx), rgba(241, 246, 241, 0.8);
}

.ghost-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 82rpx;
  height: 82rpx;
  border: 2rpx dashed rgba(109, 184, 125, 0.3);
  border-radius: 50%;
  color: rgba(74, 138, 92, 0.55);
  font-size: 34rpx;
}

.card-count-badge,
.card-rarity-badge {
  position: absolute;
  z-index: 3;
  top: 28rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1.1;
  box-shadow: 0 4rpx 12rpx rgba(46, 59, 48, 0.14);
}

.card-rarity-badge { left: 26rpx; }
.card-count-badge { right: 26rpx; background: rgba(46, 59, 48, 0.66); }
.card-rarity-badge.rarity-N { background: var(--color-n); }
.card-rarity-badge.rarity-R { background: var(--color-r); }
.card-rarity-badge.rarity-SR { background: var(--color-sr); }
.card-rarity-badge.rarity-SSR { background: var(--color-ssr); }

.card-name {
  width: 90%;
  overflow: hidden;
  color: var(--color-text);
  font-size: 24rpx;
  font-weight: 800;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-name.no-own {
  color: var(--color-subtle);
  font-weight: 600;
  letter-spacing: 3rpx;
}
