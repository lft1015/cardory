.admin-page { min-height: 100vh; padding: 40rpx 32rpx 160rpx; background: var(--color-bg); box-sizing: border-box; }

.page-title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.page-subtitle {
  color: var(--color-subtle);
  font-size: 24rpx;
  margin-bottom: 44rpx;
}

.section {
  margin-bottom: 48rpx;
}

.section-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.section-label {
  color: var(--color-subtle);
  font-size: 26rpx;
  font-weight: 600;
}

.section-help {
  color: var(--color-subtle);
  font-size: 22rpx;
}

.field-group {
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx 28rpx 22rpx;
  margin-bottom: 24rpx;
  background: var(--color-card);
  border-radius: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(46, 59, 48, 0.04);
}

.field-group:last-child {
  margin-bottom: 0;
}

.field-label {
  display: block;
  color: var(--color-subtle);
  font-size: 24rpx;
  margin-bottom: 10rpx;
}

.field-input-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.field-control {
  flex: 1;
  min-width: 0;
  min-height: 44rpx;
  padding: 0;
  color: var(--color-text);
  font-size: 30rpx;
  line-height: 44rpx;
}

.field-unit {
  flex-shrink: 0;
  color: var(--color-subtle);
  font-size: 24rpx;
}

.tip {
  padding: 20rpx 24rpx;
  color: var(--color-subtle);
  background: rgba(168, 213, 176, 0.2);
  border-radius: 16rpx;
  font-size: 24rpx;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.btn {
  width: 100%;
  min-height: 88rpx;
  box-sizing: border-box;
  border-radius: var(--radius);
  font-size: 29rpx;
  font-weight: 600;
}

.btn-primary {
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
  color: #fff;
  border: none;
}
