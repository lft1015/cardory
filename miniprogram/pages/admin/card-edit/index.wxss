.admin-page {
  min-height: 100vh;
  padding: 40rpx 32rpx 160rpx;
  background: var(--color-bg);
  box-sizing: border-box;
}

.page-title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 44rpx;
}

.section {
  margin-bottom: 48rpx;
}

.section-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.section-label {
  font-size: 26rpx;
  color: var(--color-subtle);
  font-weight: 600;
}

.section-help,
.image-hint {
  font-size: 22rpx;
  color: var(--color-subtle);
}

.image-area {
  width: 320rpx;
  height: 448rpx;
  margin: 0 auto;
  border-radius: 24rpx;
  overflow: hidden;
  background: var(--color-card);
  border: 2rpx dashed var(--color-accent);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(74, 138, 92, 0.1);
}

.preview-img {
  width: 100%;
  height: 100%;
}

.upload-placeholder {
  text-align: center;
  padding: 24rpx;
}

.upload-icon {
  font-size: 56rpx;
  color: var(--color-subtle);
  line-height: 1.2;
}

.upload-text {
  font-size: 22rpx;
  color: var(--color-subtle);
  margin-top: 8rpx;
}

.image-hint {
  text-align: center;
  margin-top: 16rpx;
}

.field-group {
  background: var(--color-card);
  margin-bottom: 24rpx;
  padding: 20rpx 28rpx 22rpx;
  border-radius: 20rpx;
  box-sizing: border-box;
  width: 100%;
  box-shadow: 0 6rpx 20rpx rgba(46, 59, 48, 0.04);
}

.field-group:last-child {
  margin-bottom: 0;
}

.field-label {
  display: block;
  color: var(--color-subtle);
  font-size: 24rpx;
  margin-bottom: 10rpx;
}

.field-control {
  display: block;
  width: 100%;
  min-height: 44rpx;
  padding: 0;
  box-sizing: border-box;
  color: var(--color-text);
  font-size: 29rpx;
  line-height: 44rpx;
}

.picker-control {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.field-arrow {
  color: var(--color-subtle);
  font-size: 36rpx;
  line-height: 1;
}

.status-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.status-chip {
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  color: #fff;
}

.status-chip.ok {
  background: #52c41a;
}

.status-chip.pending {
  background: #faad14;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.btn {
  width: 100%;
  box-sizing: border-box;
  min-height: 88rpx;
  background: var(--color-card);
  color: var(--color-text);
  border-radius: var(--radius);
  font-size: 28rpx;
  font-weight: 600;
  border: 1rpx solid rgba(0,0,0,0.08);
}

.btn-outline {
  background: transparent;
  border: 1rpx solid var(--color-primary);
  color: var(--color-primary-dark);
}

.btn-primary {
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
  color: #fff;
  border: none;
}

.btn-warn {
  background: #fff7e6;
  border: 1rpx solid #faad14;
  color: #d48806;
}

.btn-danger {
  background: #fff2f0;
  border: 1rpx solid #ff4d4f;
  color: #ff4d4f;
}
