page {
  background: linear-gradient(180deg, #f5faf6 0%, #eef6f0 40%, #f0f7f2 100%);
}

.home {
  position: relative;
  z-index: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  padding: 16rpx 32rpx 160rpx;
}

/* ====== 页面飘浮粒子 ====== */

.floating-particles {
  position: fixed;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  overflow: hidden;
}

.particle {
  position: absolute;
  top: -10%;
  opacity: 0;
  animation: floatDown linear infinite;
}

.particle.p1  { left: 5%;   animation-duration: 12s; animation-delay: 0s;   font-size: 28rpx; color: #c8e6c9; }
.particle.p2  { left: 12%;  animation-duration: 15s; animation-delay: 2s;  font-size: 22rpx; color: #a5d6a7; }
.particle.p3  { left: 20%;  animation-duration: 13s; animation-delay: 4s;  font-size: 32rpx; color: #b9dfc8; }
.particle.p4  { left: 28%;  animation-duration: 16s; animation-delay: 1s;  font-size: 20rpx; color: #d0ebd5; }
.particle.p5  { left: 36%;  animation-duration: 11s; animation-delay: 5s;  font-size: 26rpx; color: #a5d6a7; }
.particle.p6  { left: 44%;  animation-duration: 14s; animation-delay: 3s;  font-size: 24rpx; color: #c8e6c9; }
.particle.p7  { left: 52%;  animation-duration: 17s; animation-delay: 6s;  font-size: 30rpx; color: #b9dfc8; }
.particle.p8  { left: 60%;  animation-duration: 12s; animation-delay: 1.5s; font-size: 22rpx; color: #d0ebd5; }
.particle.p9  { left: 68%;  animation-duration: 15s; animation-delay: 3.5s; font-size: 28rpx; color: #a5d6a7; }
.particle.p10 { left: 76%;  animation-duration: 13s; animation-delay: 0.8s; font-size: 24rpx; color: #c8e6c9; }
.particle.p11 { left: 84%;  animation-duration: 16s; animation-delay: 4.5s; font-size: 32rpx; color: #b9dfc8; }
.particle.p12 { left: 92%;  animation-duration: 11s; animation-delay: 2.5s; font-size: 20rpx; color: #d0ebd5; }
.particle.p13 { left: 8%;   animation-duration: 14s; animation-delay: 5.5s; font-size: 26rpx; color: #a5d6a7; }
.particle.p14 { left: 48%;  animation-duration: 18s; animation-delay: 7s;   font-size: 34rpx; color: #c8e6c9; }
.particle.p15 { left: 72%;  animation-duration: 10s; animation-delay: 3s;   font-size: 24rpx; color: #b9dfc8; }
.particle.p16 { left: 88%;  animation-duration: 13s; animation-delay: 1s;   font-size: 28rpx; color: #d0ebd5; }

@keyframes floatDown {
  0% {
    opacity: 0;
    transform: translateY(-10vh) translateX(0) rotate(0deg);
  }
  5% {
    opacity: 0.5;
  }
  10% {
    opacity: 0.45;
    transform: translateY(10vh) translateX(20rpx) rotate(45deg);
  }
  25% {
    opacity: 0.35;
    transform: translateY(25vh) translateX(-16rpx) rotate(90deg);
  }
  40% {
    opacity: 0.4;
    transform: translateY(40vh) translateX(24rpx) rotate(135deg);
  }
  55% {
    opacity: 0.3;
    transform: translateY(55vh) translateX(-20rpx) rotate(180deg);
  }
  70% {
    opacity: 0.35;
    transform: translateY(70vh) translateX(16rpx) rotate(225deg);
  }
  85% {
    opacity: 0.2;
    transform: translateY(85vh) translateX(-12rpx) rotate(270deg);
  }
  95% {
    opacity: 0.08;
    transform: translateY(95vh) translateX(8rpx) rotate(315deg);
  }
  100% {
    opacity: 0;
    transform: translateY(110vh) translateX(0) rotate(360deg);
  }
}

.header {
  position: relative;
  width: 100%;
  height: 80rpx;
  margin-top: 20rpx;
  margin-bottom: 24rpx;
}

.header-left {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  white-space: nowrap;
}

.title {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--color-text);
  letter-spacing: 4rpx;
}

.subtitle {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-subtle);
}

.credit-bar {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 24rpx;
  margin-bottom: 50rpx;
}

.credit-label {
  font-size: 28rpx;
  color: var(--color-subtle);
  text-transform: uppercase;
  letter-spacing: 4rpx;
}

.credit-number {
  font-size: 42rpx;
  font-weight: 900;
  color: var(--color-primary-dark);
  line-height: 1.2;
}

.sign-in-area {
  position: absolute;
  right: 0;
  top: 4rpx;
  flex-shrink: 0;
}

.btn-sign {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 56rpx;
  background: linear-gradient(135deg, #c8e6c9, #a5d6a7);
  color: var(--color-text);
  border-radius: 28rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.btn-sign.loading {
  opacity: 0.55;
}

.signed-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 56rpx;
  font-size: 24rpx;
  color: #8fa896;
  background: rgba(168, 213, 176, 0.2);
  border-radius: 28rpx;
}

/* ====== 卡池封面 ====== */

.pool-cover {
  width: 100%;
  display: flex;
  justify-content: center;
  margin-bottom: 72rpx;
}

.pool-banner {
  width: 640rpx;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.pool-banner-bg {
  position: absolute;
  top: -20rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 600rpx;
  height: 740rpx;
  border-radius: 40rpx;
  background: linear-gradient(160deg, #e8f5e9 0%, #c8e6c9 30%, #dcedc8 60%, #f1f8e9 100%);
  box-shadow:
    0 4rpx 24rpx rgba(100, 160, 120, 0.12),
    0 12rpx 48rpx rgba(74, 138, 92, 0.08);
  z-index: 0;
}

/* 装饰星光 */
.pool-sparkles {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
  pointer-events: none;
}

.sparkle {
  position: absolute;
  font-size: 24rpx;
  opacity: 0;
}

.sparkle.s1 {
  top: 22rpx;
  left: 40rpx;
  color: #a5d6a7;
  animation: sparkleFloat 3s ease-in-out 0s infinite;
}

.sparkle.s2 {
  top: 56rpx;
  right: 36rpx;
  color: #c8e6c9;
  font-size: 20rpx;
  animation: sparkleFloat 3s ease-in-out 0.6s infinite;
}

.sparkle.s3 {
  top: 58%;
  left: 20rpx;
  color: #81c784;
  font-size: 28rpx;
  animation: sparkleFloat 3s ease-in-out 1.2s infinite;
}

.sparkle.s4 {
  top: 48%;
  right: 24rpx;
  color: #a5d6a7;
  font-size: 22rpx;
  animation: sparkleFloat 3s ease-in-out 1.8s infinite;
}

.sparkle.s5 {
  bottom: 72rpx;
  left: 50%;
  color: #c8e6c9;
  font-size: 26rpx;
  animation: sparkleFloat 3s ease-in-out 2.4s infinite;
}

@keyframes sparkleFloat {
  0%, 100% {
    opacity: 0;
    transform: translateY(0) scale(0.8);
  }
  50% {
    opacity: 0.8;
    transform: translateY(-12rpx) scale(1.1);
  }
}

/* 卡池框体 */
.pool-frame {
  position: relative;
  z-index: 2;
  margin-top: 16rpx;
}

.pool-frame-outer {
  width: 320rpx;
  height: 500rpx;
  background: linear-gradient(145deg, #d7e8d0, #bfd8bc);
  border-radius: 24rpx;
  padding: 8rpx;
  box-shadow:
    0 0 0 3rpx rgba(255, 255, 255, 0.5),
    0 8rpx 28rpx rgba(74, 100, 60, 0.18);
}

.pool-frame-inner {
  width: 100%;
  height: 100%;
  background: linear-gradient(160deg, #e8f0e4, #d4e6d0);
  border-radius: 18rpx;
  padding: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 卡背图案 */
.pool-card-back {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #4a7c59 0%, #3d6b4a 30%, #2e5a3a 60%, #4a7c59 100%);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

.pool-card-back::before {
  content: '';
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at 20% 30%, rgba(255, 255, 255, 0.08) 0%, transparent 50%),
    radial-gradient(circle at 80% 70%, rgba(255, 255, 255, 0.05) 0%, transparent 40%);
}

.pool-card-pattern {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  opacity: 0.15;
}

.pattern-line {
  width: 80%;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, #c8e6c9, transparent);
}

/* 徽章 */
.pool-emblem {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.emblem-ring {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 255, 255, 0.35);
  position: absolute;
  animation: ringPulse 2.5s ease-in-out infinite;
}

@keyframes ringPulse {
  0%, 100% {
    transform: scale(1);
    opacity: 0.5;
  }
  50% {
    transform: scale(1.12);
    opacity: 0.9;
  }
}

.emblem-star {
  font-size: 52rpx;
  color: rgba(255, 255, 255, 0.9);
  text-shadow: 0 0 20rpx rgba(255, 255, 255, 0.4);
  animation: starGlow 2s ease-in-out infinite;
}

@keyframes starGlow {
  0%, 100% {
    text-shadow: 0 0 16rpx rgba(255, 255, 255, 0.3);
  }
  50% {
    text-shadow: 0 0 32rpx rgba(255, 255, 255, 0.7);
  }
}

/* 卡池信息 */
.pool-info {
  position: relative;
  z-index: 3;
  margin-top: 32rpx;
  text-align: center;
}

.pool-label {
  font-size: 22rpx;
  color: var(--color-subtle);
  letter-spacing: 8rpx;
  text-transform: uppercase;
  margin-bottom: 8rpx;
}

.pool-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-primary-dark);
  letter-spacing: 2rpx;
}

.actions {
  display: flex;
  justify-content: center;
  width: 100%;
  padding: 0;
  margin-top: 50rpx;
}

.btn-draw {
  width: 320rpx;
  flex: none;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border: none;
  font-weight: 700;
  font-size: 26rpx;
}

.btn-draw.btn-primary {
  box-shadow: 0 6rpx 18rpx rgba(74, 138, 92, 0.18);
}

.bottom-nav {
  position: fixed;
  bottom: 20rpx;
  left: 0;
  right: 0;
  display: flex;
  z-index: 10;
  background: linear-gradient(180deg, rgba(255,255,255,0.92) 0%, #f5faf6 100%);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-top: 1rpx solid rgba(168,213,176,0.25);
  border-radius: 28rpx 28rpx 0 0;
  box-shadow:
    0 -2rpx 20rpx rgba(74,138,92,0.06),
    0 4rpx 24rpx rgba(74,138,92,0.08),
    inset 0 1rpx 0 rgba(255,255,255,0.8);
}

.nav-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-subtle);
  position: relative;
  transition: all 0.2s ease;
}

.nav-item::after {
  content: '';
  position: absolute;
  bottom: 16rpx;
  left: 50%;
  transform: translateX(-50%) scaleX(0);
  width: 36rpx;
  height: 4rpx;
  background: linear-gradient(90deg, var(--color-primary), var(--color-primary-light));
  border-radius: 2rpx;
  transition: transform 0.25s ease;
}

.nav-item:active {
  color: var(--color-text);
  background: rgba(168,213,176,0.12);
}

.nav-item:active::after {
  transform: translateX(-50%) scaleX(1);
}

.result-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}
