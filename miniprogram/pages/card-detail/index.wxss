.detail {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx;
}

.detail-card {
  width: 320rpx;
  height: 448rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 32rpx;
  position: relative;
}

.detail-card.rarity-N  { background: rgba(139,154,107,0.14); box-shadow: 0 4rpx 24rpx rgba(139,154,107,0.18); }
.detail-card.rarity-R  { background: rgba(91,140,201,0.14); box-shadow: 0 4rpx 24rpx rgba(91,140,201,0.18); }
.detail-card.rarity-SR { background: rgba(155,89,182,0.14); box-shadow: 0 4rpx 24rpx rgba(155,89,182,0.18); }
.detail-card.rarity-SSR { background: rgba(201,160,43,0.14); box-shadow: 0 4rpx 24rpx rgba(201,160,43,0.22); }

.detail-card::after {
  content: '';
  position: absolute;
  inset: 6rpx;
  border-radius: 10rpx;
  border: 2rpx solid currentColor;
  opacity: 0.2;
  pointer-events: none;
}

.detail-img {
  width: 100%;
  height: 100%;
}

.detail-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  box-sizing: border-box;
}

.placeholder-name {
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
}

.detail-info {
  text-align: center;
}

.detail-name {
  font-size: 38rpx;
  font-weight: 800;
  margin-bottom: 12rpx;
}

.detail-rarity {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.detail-count {
  font-size: 26rpx;
  color: var(--color-subtle);
}
