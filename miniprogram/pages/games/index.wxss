page {
  background: linear-gradient(180deg, #f5faf6 0%, #eef6f0 48%, #f5faf6 100%);
}

.games-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 34rpx 28rpx 80rpx;
}

.games-hero {
  padding: 38rpx 28rpx 34rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 30rpx;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.9), rgba(225, 241, 228, 0.88));
  box-shadow: 0 16rpx 42rpx rgba(74, 138, 92, 0.1);
  text-align: center;
}

.games-kicker {
  color: var(--color-primary-dark);
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 5rpx;
  opacity: 0.7;
}

.games-title {
  margin-top: 8rpx;
  color: var(--color-text);
  font-size: 48rpx;
  font-weight: 900;
  letter-spacing: 6rpx;
}

.games-subtitle {
  margin-top: 8rpx;
  color: var(--color-subtle);
  font-size: 23rpx;
}

.games-list {
  margin-top: 28rpx;
}

.game-item {
  display: flex;
  align-items: center;
  min-height: 142rpx;
  box-sizing: border-box;
  margin-bottom: 18rpx;
  padding: 24rpx 22rpx;
  border: 1rpx solid rgba(109, 184, 125, 0.16);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.84);
  box-shadow: 0 10rpx 28rpx rgba(74, 138, 92, 0.08);
}

.game-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 76rpx;
  width: 76rpx;
  height: 76rpx;
  margin-right: 18rpx;
  border-radius: 22rpx;
  font-size: 42rpx;
  font-weight: 700;
}

.game-icon-watermelon {
  color: #4a8a5c;
  background: #e4f2e6;
}

.game-icon-luck {
  color: #b28b31;
  background: #f8f0d9;
}

.game-copy {
  min-width: 0;
  flex: 1;
}

.game-name {
  color: var(--color-text);
  font-size: 29rpx;
  font-weight: 800;
}

.game-description {
  margin-top: 5rpx;
  color: var(--color-subtle);
  font-size: 21rpx;
  line-height: 1.45;
}

.game-status {
  flex: 0 0 auto;
  margin-left: 12rpx;
  padding: 7rpx 10rpx;
  color: var(--color-subtle);
  border: 1rpx solid rgba(125, 154, 131, 0.28);
  border-radius: 999rpx;
  background: rgba(245, 250, 246, 0.9);
  font-size: 18rpx;
  white-space: nowrap;
}
