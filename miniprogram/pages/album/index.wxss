page {
  background: radial-gradient(circle at 12% 8%, rgba(168, 213, 176, 0.24), transparent 30%), linear-gradient(180deg, #f8fcf8 0%, #edf6ef 48%, #f4f8f4 100%);
}

.album {
  position: relative;
  z-index: 0;
  min-height: 100vh;
  padding: 24rpx 24rpx 120rpx;
  box-sizing: border-box;
}

.floating-particles {
  position: fixed;
  inset: 0;
  z-index: -1;
  overflow: hidden;
  pointer-events: none;
}

.particle {
  position: absolute;
  top: -10%;
  color: #b9dfc8;
  opacity: 0;
  animation: floatDown linear infinite;
}

.p1 { left: 5%; animation-duration: 12s; font-size: 24rpx; }
.p2 { left: 18%; animation-duration: 15s; animation-delay: 2s; font-size: 20rpx; }
.p3 { left: 32%; animation-duration: 13s; animation-delay: 4s; font-size: 28rpx; }
.p4 { left: 48%; animation-duration: 16s; animation-delay: 1s; font-size: 18rpx; }
.p5 { left: 60%; animation-duration: 11s; animation-delay: 5s; font-size: 22rpx; }
.p6 { left: 75%; animation-duration: 14s; animation-delay: 3s; font-size: 26rpx; }
.p7 { left: 88%; animation-duration: 17s; animation-delay: 6s; font-size: 20rpx; }
.p8 { left: 95%; animation-duration: 12s; animation-delay: 2.5s; font-size: 24rpx; }

@keyframes floatDown {
  0% { opacity: 0; transform: translateY(-10vh) rotate(0); }
  8% { opacity: 0.45; }
  50% { opacity: 0.28; transform: translateY(55vh) translateX(20rpx) rotate(180deg); }
  100% { opacity: 0; transform: translateY(110vh) rotate(360deg); }
}

.album-hero {
  position: relative;
  overflow: hidden;
  margin-bottom: 22rpx;
  padding: 34rpx 30rpx 28rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 34rpx;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.9), rgba(231, 244, 234, 0.82));
  box-shadow: 0 18rpx 46rpx rgba(74, 138, 92, 0.12), inset 0 0 0 1rpx rgba(109, 184, 125, 0.08);
}

.hero-orb {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.hero-orb-a {
  top: -110rpx;
  right: -70rpx;
  width: 280rpx;
  height: 280rpx;
  background: radial-gradient(circle, rgba(109, 184, 125, 0.28), transparent 68%);
}

.hero-orb-b {
  left: -80rpx;
  bottom: -130rpx;
  width: 260rpx;
  height: 260rpx;
  background: radial-gradient(circle, rgba(168, 213, 176, 0.3), transparent 70%);
}

.album-header,
.album-progress {
  position: relative;
  z-index: 1;
}

.album-header { text-align: center; }

.album-kicker {
  margin-bottom: 6rpx;
  color: var(--color-primary-dark);
  font-size: 17rpx;
  font-weight: 800;
  letter-spacing: 5rpx;
  opacity: 0.68;
}

.album-title {
  color: var(--color-text);
  font-size: 44rpx;
  font-weight: 900;
  letter-spacing: 5rpx;
}

.album-subtitle {
  margin-top: 6rpx;
  color: var(--color-subtle);
  font-size: 23rpx;
}

.album-progress {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid rgba(109, 184, 125, 0.15);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.68);
}

.progress-summary {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}

.progress-label {
  color: var(--color-subtle);
  font-size: 21rpx;
  font-weight: 700;
}

.progress-text {
  display: flex;
  align-items: baseline;
}

.progress-num {
  color: var(--color-primary-dark);
  font-size: 38rpx;
  font-weight: 900;
}

.progress-div,
.progress-total {
  color: var(--color-subtle);
  font-size: 24rpx;
}

.progress-div { margin: 0 4rpx; }

.progress-percent {
  color: var(--color-primary-dark);
  font-size: 25rpx;
  font-weight: 900;
}

.progress-bar {
  width: 100%;
  height: 13rpx;
  margin-top: 14rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(74, 138, 92, 0.1);
}

.progress-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, var(--color-primary-dark), var(--color-primary), #a8d5b0);
  box-shadow: 0 0 14rpx rgba(109, 184, 125, 0.42);
  transition: width 0.4s ease;
}

.filter-shell {
  position: relative;
  z-index: 3;
  margin-bottom: 26rpx;
  padding: 7rpx;
  border: 1rpx solid rgba(109, 184, 125, 0.13);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.8);
  box-shadow: 0 10rpx 28rpx rgba(74, 138, 92, 0.09);
}

.filter-bar { display: flex; gap: 5rpx; }

.filter-chip {
  flex: 1;
  padding: 11rpx 0;
  border-radius: 999rpx;
  color: var(--color-subtle);
  font-size: 23rpx;
  font-weight: 700;
  text-align: center;
  transition: transform 0.2s, background 0.2s;
}

.filter-chip.active {
  color: #fff;
  background: var(--color-primary);
  box-shadow: 0 5rpx 14rpx rgba(74, 138, 92, 0.2);
  transform: translateY(-1rpx);
}

.filter-chip.active.rarity-N { background: var(--color-n); }
.filter-chip.active.rarity-R { background: var(--color-r); }
.filter-chip.active.rarity-SR { background: var(--color-sr); }
.filter-chip.active.rarity-SSR { background: var(--color-ssr); }

.card-grid {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  gap: 24rpx 20rpx;
}

.card-cell {
  display: flex;
  justify-content: center;
  width: calc(50% - 10rpx);
}

.empty-hint {
  margin-top: 20rpx;
  padding: 76rpx 20rpx;
  border: 2rpx dashed rgba(109, 184, 125, 0.24);
  border-radius: 30rpx;
  color: var(--color-subtle);
  text-align: center;
  background: rgba(255, 255, 255, 0.54);
}

.empty-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  margin: 0 auto 18rpx;
  border-radius: 50%;
  color: var(--color-primary);
  font-size: 34rpx;
  background: rgba(109, 184, 125, 0.12);
}

.empty-title { color: var(--color-text); font-size: 28rpx; font-weight: 800; }
.empty-copy { margin-top: 5rpx; font-size: 22rpx; }

.detail-panel {
  position: fixed;
  z-index: 20;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: rgba(238, 246, 240, 0.96);
}

.detail-halo {
  position: absolute;
  left: 50%;
  top: 47%;
  width: 720rpx;
  height: 720rpx;
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

.detail-halo.rarity-N { background: radial-gradient(circle, rgba(106, 155, 91, 0.3), transparent 68%); }
.detail-halo.rarity-R { background: radial-gradient(circle, rgba(91, 140, 201, 0.3), transparent 68%); }
.detail-halo.rarity-SR { background: radial-gradient(circle, rgba(139, 92, 184, 0.3), transparent 68%); }
.detail-halo.rarity-SSR { background: radial-gradient(circle, rgba(201, 160, 43, 0.34), transparent 68%); }

.detail-particles {
  position: absolute;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
}

.dparticle {
  position: absolute;
  top: -10%;
  color: #b9dfc8;
  opacity: 0;
  animation: detailFloat linear infinite;
}

.dp1 { left: 15%; animation-duration: 12s; font-size: 24rpx; }
.dp2 { left: 35%; animation-duration: 14s; animation-delay: 2s; font-size: 20rpx; }
.dp3 { left: 60%; animation-duration: 13s; animation-delay: 4s; font-size: 28rpx; }
.dp4 { left: 80%; animation-duration: 15s; animation-delay: 1s; font-size: 18rpx; }

@keyframes detailFloat {
  0% { opacity: 0; transform: translateY(-10vh) rotate(0); }
  8% { opacity: 0.38; }
  100% { opacity: 0; transform: translateY(110vh) rotate(360deg); }
}

.detail-content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 590rpx;
  padding: 24rpx 28rpx 34rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(255, 255, 255, 0.88);
  border-radius: 38rpx;
  background: rgba(255, 255, 255, 0.7);
  box-shadow: 0 28rpx 80rpx rgba(46, 59, 48, 0.15);
  animation: detailScaleIn 0.25s ease-out;
}

@keyframes detailScaleIn {
  from { opacity: 0; transform: translateY(18rpx) scale(0.96); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

.detail-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  margin-bottom: 18rpx;
}

.detail-eyebrow {
  color: var(--color-primary-dark);
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.detail-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  color: var(--color-primary-dark);
  font-size: 38rpx;
  line-height: 1;
  background: rgba(109, 184, 125, 0.12);
}

.detail-image-wrap { position: relative; width: 360rpx; height: 504rpx; max-height: 58vh; }

.detail-frame {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  border: 2rpx solid rgba(255, 255, 255, 0.76);
  border-radius: 28rpx;
  box-shadow: 0 18rpx 50rpx rgba(46, 59, 48, 0.18), inset 0 0 0 4rpx rgba(255, 255, 255, 0.22);
}

.detail-frame.rarity-N { background: rgba(106, 155, 91, 0.3); }
.detail-frame.rarity-R { background: rgba(91, 140, 201, 0.3); }
.detail-frame.rarity-SR { background: rgba(139, 92, 184, 0.3); }
.detail-frame.rarity-SSR { background: linear-gradient(135deg, rgba(201, 160, 43, 0.42), rgba(109, 184, 125, 0.2)); }

.detail-frame::after {
  content: '';
  position: absolute;
  inset: 8rpx;
  border: 2rpx solid currentColor;
  border-radius: 21rpx;
  opacity: 0.35;
  pointer-events: none;
}

.detail-frame.rarity-N::after { color: var(--color-n); }
.detail-frame.rarity-R::after { color: var(--color-r); }
.detail-frame.rarity-SR::after { color: var(--color-sr); }
.detail-frame.rarity-SSR::after { color: var(--color-ssr); }

.detail-image,
.detail-image-placeholder { width: 100%; height: 100%; }

.detail-image-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
  color: var(--color-text);
  font-size: 32rpx;
  font-weight: 800;
  text-align: center;
}

.detail-rarity-chip {
  position: absolute;
  z-index: 2;
  left: 20rpx;
  top: 20rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 22rpx;
  font-weight: 900;
  box-shadow: 0 4rpx 12rpx rgba(46, 59, 48, 0.14);
}

.detail-rarity-chip.rarity-N { background: var(--color-n); }
.detail-rarity-chip.rarity-R { background: var(--color-r); }
.detail-rarity-chip.rarity-SR { background: var(--color-sr); }
.detail-rarity-chip.rarity-SSR { background: var(--color-ssr); }

.detail-caption {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 360rpx;
  margin-top: 20rpx;
}

.detail-name {
  max-width: 230rpx;
  overflow: hidden;
  color: var(--color-text);
  font-size: 30rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-count {
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  color: var(--color-primary-dark);
  font-size: 20rpx;
  font-weight: 800;
  background: rgba(109, 184, 125, 0.13);
}

@media (prefers-reduced-motion: reduce) {
  .particle,
  .dparticle,
  .detail-content { animation: none; }
}
